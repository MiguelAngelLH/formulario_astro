---
import '../styles/variables.css';
import '../styles/global.css';

type Props = {
  title: string;
  lang?: string;
	initialHash?: string;
};

const { title, lang = 'es', initialHash } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!DOCTYPE HTML>
<!--
	Dimension by HTML5 UP
	html5up.net | @ajlkn
	Free for personal and commercial use under the CCA 3.0 license (html5up.net/license)
-->
<html lang={lang}>
	<head>
		<title>{title}</title>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no" />
		<link rel="stylesheet" href={`${base}/assets/css/main.css`} />
		<noscript><link rel="stylesheet" href={`${base}/assets/css/noscript.css`} /></noscript>
	</head>
	<body class="is-preload">
		<!-- Wrapper -->
			<div id="wrapper">
				<slot name="header" />

				<!-- Main -->
					<div id="main">
						<slot />
					</div>

				<slot name="footer" />
			</div>

		<!-- BG -->
			<div id="bg"></div>

		{initialHash ? (
			<script is:inline>{`if (!location.hash) location.hash = ${JSON.stringify(initialHash)};`}</script>
		) : null}

		<!-- Scripts (keep inline so Astro doesn't try to bundle public assets) -->
			<script src={`${base}/assets/js/jquery.min.js`} is:inline></script>
			<script src={`${base}/assets/js/browser.min.js`} is:inline></script>
			<script src={`${base}/assets/js/breakpoints.min.js`} is:inline></script>
			<script src={`${base}/assets/js/util.js`} is:inline></script>
			<script src={`${base}/assets/js/main.js`} is:inline></script>
	</body>
</html>

											<span class="tech-badge" style="--d: 0ms"><span class="icon brands fa-react"></span>React</span>
											<span class="tech-badge" style="--d: 80ms"><span class="icon brands fa-react"></span>React Native</span>
											<span class="tech-badge" style="--d: 160ms"><span class="icon solid fa-mobile-alt"></span>Flutter</span>
											<span class="tech-badge" style="--d: 240ms"><span class="icon solid fa-cube"></span>Three.js</span>
											<span class="tech-badge" style="--d: 320ms"><span class="icon brands fa-js"></span>JavaScript</span>
										</div>
									</section>


---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Card from '../components/Card.astro';

const title = 'Miguel Ángel López Hernández - Portfolio';
---

<BaseLayout title={title}>
	<Header
		name="Miguel Ángel López Hernández"
		tagline="Desarrollador Full Stack & IoT | Ingeniero en Desarrollo y Gestión de Software"
		photoSrc="/images/MiFoto.jpg"
		slot="header"
	/>

	<!-- Intro -->
	<article id="intro">
		<h2 class="major">Sobre Mí</h2>
		<span class="image right" style="max-width: 30%;"><img src="/images/MiFoto.jpg" alt="Miguel Ángel López Hernández" /></span>
		<p>Soy un ingeniero en desarrollo de software apasionado por crear soluciones tecnológicas que generen un impacto real. Mi experiencia abarca desde el desarrollo web y móvil hasta la implementación de sistemas IoT y experiencias inmersivas con realidad virtual. Me especializo en construir aplicaciones escalables, intuitivas y orientadas al usuario, siempre con un enfoque en la calidad del código y el trabajo colaborativo.</p>
		<p>💡 <strong>Mi misión:</strong> Transformar ideas en productos digitales que resuelvan problemas reales y mejoren la vida de las personas.</p>
	</article>

	<!-- Work -->
	<article id="work">
		<h2 class="major">Proyectos Destacados</h2>
		<span class="image main"><img src="/images/pic02.jpg" alt="" /></span>

		<Card title="🎓 exploraR - Plataforma de Orientación Vocacional VR" imageSrc="/images/img-projects/EXPLORAR.png">
			<p>Aplicación móvil con realidad virtual para reducir la deserción universitaria.</p>
			<p><strong>Tecnologías:</strong> React Native, Three.js, Node.js, MongoDB, Express.js</p>
			<p><strong>Características:</strong> tours virtuales inmersivos, micro-vivencias académicas, testimonios 360°, panel admin, analytics.</p>
		</Card>

		<Card title="🛡️ SafeCheck School - Sistema de Detección de Alcohol" imageSrc="/images/img-projects/SAFECHECK.png">
			<p>Plataforma web/móvil para detectar alcohol en estudiantes mediante IoT.</p>
			<p><strong>Tecnologías:</strong> React, Node.js, MongoDB, ESP32, Sensores MQ-3</p>
			<p><strong>Impacto:</strong> mejora la seguridad escolar mediante tecnología accesible y automatizada.</p>
		</Card>

		<Card title="♻️ RECOU - Plataforma de Donación Solidaria" imageSrc="/images/img-projects/RECOU_LOGOTIPO_blanco.png">
			<p>Sistema para reciclar PET/aluminio y apoyar la creación de prótesis.</p>
			<p><strong>Tecnologías:</strong> JavaScript, PHP, MySQL</p>
			<p><strong>Impacto:</strong> conecta el reciclaje con causas sociales.</p>
		</Card>

		<Card title="📱 Sistema de Registro de Entradas" imageSrc="/images/img-projects/note-app.png">
			<p>App móvil para gestionar acceso estudiantil en instituciones.</p>
			<p><strong>Tecnologías:</strong> Flutter, SQLite</p>
			<p><strong>Características:</strong> registro entrada/salida, reportes de asistencia.</p>
		</Card>
	</article>

	<!-- About -->
	<article id="about">
		<h2 class="major">Formación y Tecnologías</h2>
		<span class="image main"><img src="/images/pic03.jpg" alt="" /></span>
		<p><strong>🎓 Formación Académica:</strong> Ingeniero en Desarrollo y Gestión de Software (Actual), TSU en Tecnologías de la Información (Concluido).</p>
		<h3 class="major">Stack Tecnológico</h3>
		<div class="tech-wrap">
			<section class="tech-group">
				<h4>Interfaz</h4>
				<div class="tech-badges">
					<span class="tech-badge" style="--d: 0ms"><span class="icon brands fa-react"></span>React</span>
					<span class="tech-badge" style="--d: 80ms"><span class="icon brands fa-react"></span>React Native</span>
					<span class="tech-badge" style="--d: 160ms"><span class="icon solid fa-mobile-alt"></span>Flutter</span>
					<span class="tech-badge" style="--d: 240ms"><span class="icon solid fa-cube"></span>Three.js</span>
					<span class="tech-badge" style="--d: 320ms"><span class="icon brands fa-js"></span>JavaScript</span>
				</div>
			</section>

			<section class="tech-group">
				<h4>Backend</h4>
				<div class="tech-badges">
					<span class="tech-badge" style="--d: 0ms"><span class="icon brands fa-node-js"></span>Node.js</span>
					<span class="tech-badge" style="--d: 80ms"><span class="icon solid fa-server"></span>Express.js</span>
					<span class="tech-badge" style="--d: 160ms"><span class="icon brands fa-python"></span>Python</span>
					<span class="tech-badge" style="--d: 240ms"><span class="icon brands fa-php"></span>PHP</span>
				</div>
			</section>

			<section class="tech-group">
				<h4>Bases de datos</h4>
				<div class="tech-badges">
					<span class="tech-badge" style="--d: 0ms"><span class="icon solid fa-leaf"></span>MongoDB</span>
					<span class="tech-badge" style="--d: 80ms"><span class="icon solid fa-database"></span>MySQL</span>
					<span class="tech-badge" style="--d: 160ms"><span class="icon solid fa-database"></span>SQLite</span>
				</div>
			</section>

			<section class="tech-group">
				<h4>IoT y hardware</h4>
				<div class="tech-badges">
					<span class="tech-badge" style="--d: 0ms"><span class="icon solid fa-microchip"></span>Arduino</span>
					<span class="tech-badge" style="--d: 80ms"><span class="icon solid fa-wifi"></span>ESP32</span>
				</div>
			</section>

			<section class="tech-group">
				<h4>Herramientas y nube</h4>
				<div class="tech-badges">
					<span class="tech-badge" style="--d: 0ms"><span class="icon brands fa-git-alt"></span>Git</span>
					<span class="tech-badge" style="--d: 80ms"><span class="icon solid fa-cloud"></span>Cloudinary</span>
					<span class="tech-badge" style="--d: 160ms"><span class="icon solid fa-cubes"></span>Unity</span>
				</div>
			</section>
		</div>
		<p><strong>💼 Especialidades:</strong> Desarrollo Full Stack, Aplicaciones Móviles, Realidad Virtual, IoT, Arquitectura de Software.</p>
	</article>

	<!-- Contact -->
	<article id="contact">
		<h2 class="major">Contacto</h2>
		<form id="contact-form" method="post" action="/api/contact" novalidate>
			<div class="fields">
				<div class="field half">
					<label for="name">Nombre</label>
					<input type="text" name="name" id="name" autocomplete="name" required />
				</div>
				<div class="field half">
					<label for="email">Correo</label>
					<input type="email" name="email" id="email" autocomplete="email" required />
				</div>
				<div class="field">
					<label for="subject">Asunto</label>
					<input type="text" name="subject" id="subject" placeholder="Ej. Propuesta / Vacante / Colaboración" />
				</div>
				<div class="field">
					<label for="message">Mensaje</label>
					<textarea name="message" id="message" rows="4" required placeholder="Cuéntame en qué puedo ayudarte..."></textarea>
				</div>

				<!-- Honeypot (anti-spam): debe quedarse vacío -->
				<div class="field" style="position:absolute; left:-9999px; top:auto; width:1px; height:1px; overflow:hidden;">
					<label for="company">Company</label>
					<input type="text" name="company" id="company" tabindex="-1" autocomplete="off" />
				</div>
			</div>

			<p id="contact-status" class="form-status" hidden></p>
			<ul class="actions">
				<li><input id="contact-submit" type="submit" value="Enviar" class="primary" /></li>
				<li><input type="reset" value="Limpiar" /></li>
			</ul>
		</form>

		<script is:inline>
			(function () {
				var form = document.getElementById('contact-form');
				var statusEl = document.getElementById('contact-status');
				var submitBtn = document.getElementById('contact-submit');
				var emailInput = document.getElementById('email');
				if (!form || !statusEl || !submitBtn) return;

				function setStatus(kind, text) {
					statusEl.hidden = false;
					statusEl.classList.remove('is-success', 'is-error');
					statusEl.classList.add(kind === 'success' ? 'is-success' : 'is-error');
					statusEl.textContent = text;
				}

				form.addEventListener('submit', function (e) {
					e.preventDefault();
					statusEl.hidden = true;
					var senderEmail = emailInput && emailInput.value ? String(emailInput.value) : '';

					submitBtn.disabled = true;
					var oldValue = submitBtn.value;
					submitBtn.value = 'Enviando...';

					fetch(form.action, {
						method: 'POST',
						body: new FormData(form),
						headers: { 'accept': 'application/json' },
					})
						.then(function (r) { return r.json().catch(function () { return null; }).then(function (j) { return { ok: r.ok, data: j }; }); })
						.then(function (res) {
							var data = res && res.data ? res.data : null;
							if (res.ok && data && data.ok) {
								var baseMsg = data.message || '¡Listo! Tu mensaje fue enviado.';
								if (senderEmail) baseMsg = baseMsg + ' Te responderé a: ' + senderEmail;
								setStatus('success', baseMsg);
								form.reset();
								return;
							}
							setStatus('error', (data && data.message) ? data.message : 'No se pudo enviar. Intenta más tarde.');
						})
						.catch(function () {
							setStatus('error', 'No se pudo enviar. Revisa tu conexión e intenta de nuevo.');
						})
						.finally(function () {
							submitBtn.disabled = false;
							submitBtn.value = oldValue;
						});
				});
			})();
		</script>

		<ul class="icons">
			<li><a href="https://www.linkedin.com/in/miguelangel-lopez-551a163a5/" class="icon brands fa-linkedin"><span class="label">LinkedIn</span></a></li>
			<li><a href="https://github.com/MiguelAngelLH" class="icon brands fa-github"><span class="label">GitHub</span></a></li>
			<li><a href="mailto:miguelhdez0903@gmail.com" class="icon solid fa-envelope"><span class="label">Email</span></a></li>
		</ul>
	</article>

	<Footer slot="footer" text="© Miguel Ángel López Hernández. Portfolio 2026." />
</BaseLayout>

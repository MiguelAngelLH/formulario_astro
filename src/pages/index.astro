								<p><strong>💼 Especialidades:</strong> Desarrollo Full Stack, Aplicaciones Móviles, Realidad Virtual, IoT, Arquitectura de Software.</p>

								<style>
									.tech-group + .tech-group { margin-top: 1.75rem; }
									.tech-group h4 { margin: 0 0 0.75rem 0; letter-spacing: 0.2em; text-transform: uppercase; font-size: 0.8rem; opacity: 0.9; }
									.tech-badges {
										display: flex;
										flex-wrap: wrap;
										gap: 0.75rem;
									}
									.tech-badge {
										position: relative;
										display: inline-flex;
										align-items: center;
										gap: 0.6rem;
										padding: 0.55rem 0.9rem;
										border: 1px solid rgba(255,255,255,0.35);
										border-radius: 0.35rem;
										background: rgba(255,255,255,0.04);
										backdrop-filter: blur(6px);
										-webkit-backdrop-filter: blur(6px);
										letter-spacing: 0.12em;
										text-transform: uppercase;
										font-size: 0.7rem;
										line-height: 1;
										cursor: default;
										transform: translateY(6px);
										opacity: 0;
										animation: techIn 520ms ease forwards;
										animation-delay: var(--d, 0ms);
									}
									.tech-badge:before {
										content: '';
										position: absolute;
										inset: 0;
										border-radius: inherit;
										background: linear-gradient(120deg, transparent 0%, rgba(255,255,255,0.14) 45%, transparent 70%);
										transform: translateX(-120%);
										opacity: 0;
										transition: transform 600ms ease, opacity 200ms ease;
										pointer-events: none;
									}
									.tech-badge .icon {
										width: 1.25em;
										text-align: center;
										transition: transform 260ms ease;
									}
									.tech-badge:hover {
										transform: translateY(-2px) scale(1.03);
										border-color: rgba(255,255,255,0.6);
										background: rgba(255,255,255,0.07);
										box-shadow: 0 10px 30px rgba(0,0,0,0.25);
									}
									.tech-badge:hover:before { opacity: 1; transform: translateX(120%); }
									.tech-badge:hover .icon { transform: rotate(-10deg) scale(1.15); }
									@keyframes techIn {
										to { opacity: 1; transform: translateY(0); }
									}
									@media (prefers-reduced-motion: reduce) {
										.tech-badge { animation: none; opacity: 1; transform: none; }
										.tech-badge:before { transition: none; }
										.tech-badge .icon { transition: none; }
									}
								</style>

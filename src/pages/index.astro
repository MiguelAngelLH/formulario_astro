											<span class="tech-badge" style="--d: 80ms"><span class="icon solid fa-server"></span>Express.js</span>
											<span class="tech-badge" style="--d: 160ms"><span class="icon brands fa-python"></span>Python</span>
											<span class="tech-badge" style="--d: 240ms"><span class="icon brands fa-php"></span>PHP</span>
										</div>
									</section>


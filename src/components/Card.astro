---
type Props = {
  title: string;
  imageSrc?: string;
  imageAlt?: string;
};

const { title, imageSrc, imageAlt = title } = Astro.props;
const base = import.meta.env.BASE_URL || '/';
---

<section class="box">
	{imageSrc ? (
		<span class="image left" style="max-width: 110px;">
			<img src={imageSrc && imageSrc.startsWith('/') ? `${base}${imageSrc.slice(1)}` : imageSrc} alt={imageAlt} />
		</span>
	) : null}
	<h3>{title}</h3>
	<slot />
</section>

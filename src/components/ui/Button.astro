---
type Props = {
  href?: string;
  variant?: 'primary' | 'default';
};

const { href, variant = 'default' } = Astro.props;
const className = variant === 'primary' ? 'button primary' : 'button';
---

{href ? (
  <a href={href} class={className}><slot /></a>
) : (
  <button class={className} type="button"><slot /></button>
)}

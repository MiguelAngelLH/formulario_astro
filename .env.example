# MailerSend (server-only)
MAILERSEND_API_KEY=your_api_key_here

# Debe ser un dominio/usuario verificado en MailerSend
MAILERSEND_FROM_EMAIL=no-reply@tudominio.com
MAILERSEND_FROM_NAME="Portafolio Miguel Ángel"

# A dónde llegan los mensajes del formulario
MAILERSEND_TO_EMAIL=tu_correo@ejemplo.com
